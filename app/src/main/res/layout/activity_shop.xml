<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_top">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/shop_title"
            android:textColor="@color/score_text"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/shopCoinsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/score_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rocket"
                android:textColor="@color/score_text"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/rocketPriceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="@color/score_text"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/rocketOwnedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="@color/score_text"
                android:textSize="13sp" />
            <Button
                android:id="@+id/buyRocketButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buy_button" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bomb"
                android:textColor="@color/score_text"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/bombPriceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="@color/score_text"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/bombOwnedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="@color/score_text"
                android:textSize="13sp" />
            <Button
                android:id="@+id/buyBombButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buy_button" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/paddle"
                android:textColor="@color/score_text"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/paddlePriceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="@color/score_text"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/paddleOwnedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="@color/score_text"
                android:textSize="13sp" />
            <Button
                android:id="@+id/buyPaddleButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buy_button" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
